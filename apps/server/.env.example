MENULENS_MODE=fixture
# Set postgres to use InsForge for pairing even when menus are fixtures.
MENULENS_STORE=memory
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Defaults to disabled for fixtures and insforge for live mode. Keep authentication enabled in production.
MENULENS_AUTH=
INSFORGE_URL=
INSFORGE_ANON_KEY=
# Generate once with crypto.randomBytes(32); store as a write-only server secret.
MCP_USE_OAUTH_SECRET=
# Live mode requires a database and a funded wallet. Never put these in the mobile app.
INSFORGE_DATABASE_URL=
MENULENS_INFERENCE=x402
# Optional: set MENULENS_INFERENCE=gateway to use an InsForge/OpenRouter key instead.
INSFORGE_AI_BASE_URL=https://openrouter.ai/api/v1
INSFORGE_AI_API_KEY=
INSFORGE_AI_MODEL=openai/gpt-4o-mini
X402_PRIVATE_KEY=
MAX_CALL_USD=0.10
MAX_WORKFLOW_USD=0.50
MAX_DAILY_USD=10
# Bind this to a private interface or use a firewall when exposing development.
HOST=127.0.0.1
